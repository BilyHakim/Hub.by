# Compose production configuration. Copy to .env.production and replace placeholders.
POSTGRES_DB=hubby
POSTGRES_USER=hubby
POSTGRES_PASSWORD=replace_with_a_strong_database_password
DATABASE_URL=postgres://hubby:replace_with_url_encoded_database_password@postgres:5432/hubby?sslmode=disable

APP_PORT=8080
FRONTEND_PORT=8080
FRONTEND_ORIGIN=https://bilyhakim.site
CORS_ALLOWED_ORIGINS=http://localhost:1420
TRUST_PROXY=true

AUTH_EMAIL=replace_with_your_login_email
AUTH_INITIAL_PASSWORD=replace_with_at_least_10_characters
TMDB_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAIRING_CODE=
TELEGRAM_LOCAL_USER_ID=1
TELEGRAM_TIMEZONE=Asia/Jakarta
